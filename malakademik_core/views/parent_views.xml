<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_malakademik_parent_tree" model="ir.ui.view">
        <field name="name">malakademik.parent.list</field>
        <field name="model">malakademik.parent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="relation"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_malakademik_parent_form" model="ir.ui.view">
        <field name="name">malakademik.parent.form</field>
        <field name="model">malakademik.parent</field>
        <field name="arch" type="xml">
            <form string="Parent/Guardian">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="relation"/>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="student_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- action moved to views/actions.xml -->
</odoo>
