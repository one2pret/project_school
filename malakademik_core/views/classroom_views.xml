<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_malakademik_classroom_list" model="ir.ui.view">
        <field name="name">malakademik.classroom.list</field>
        <field name="model">malakademik.classroom</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="grade"/>
                <field name="homeroom_teacher_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_malakademik_classroom_form" model="ir.ui.view">
        <field name="name">malakademik.classroom.form</field>
        <field name="model">malakademik.classroom</field>
        <field name="arch" type="xml">
            <form string="Classroom">
                <header>
                    <button type="object" name="action_view_students" class="oe_stat_button" icon="fa-users">
                        <field name="student_count" widget="statinfo" string="Students"/>
                    </button>
                    <button type="object" name="action_view_schedules" class="oe_stat_button" icon="fa-calendar">
                        <field name="schedule_count" widget="statinfo" string="Schedules"/>
                    </button>
                    <button type="object" name="action_view_attendance" class="oe_stat_button" icon="fa-check-square-o">
                        <field name="attendance_count" widget="statinfo" string="Attendance"/>
                    </button>
                    <button type="object" name="action_view_assessments" class="oe_stat_button" icon="fa-check-circle">
                        <field name="assessment_count" widget="statinfo" string="Assessments"/>
                    </button>
                    <button type="object" name="action_view_assignments" class="oe_stat_button" icon="fa-file-text-o">
                        <field name="assignment_count" widget="statinfo" string="Assignments"/>
                    </button>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="grade"/>
                            <field name="homeroom_teacher_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- action moved to views/actions.xml -->
</odoo>
