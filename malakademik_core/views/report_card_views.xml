<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_malakademik_report_card_list" model="ir.ui.view">
        <field name="name">malakademik.report.card.list</field>
        <field name="model">malakademik.report.card</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="term"/>
                <field name="year"/>
                <field name="average"/>
            </list>
        </field>
    </record>

    <record id="view_malakademik_report_card_form" model="ir.ui.view">
        <field name="name">malakademik.report.card.form</field>
        <field name="model">malakademik.report.card</field>
        <field name="arch" type="xml">
            <form string="Report Card">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="term"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="average" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="score"/>
                                    <field name="grade"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- action moved to views/actions.xml -->
</odoo>
