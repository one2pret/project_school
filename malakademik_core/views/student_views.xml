<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_malakademik_student_tree" model="ir.ui.view">
        <field name="name">malakademik.student.list</field>
        <field name="model">malakademik.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="gender"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_malakademik_student_form" model="ir.ui.view">
        <field name="name">malakademik.student.form</field>
        <field name="model">malakademik.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="student_id"/>
                            <field name="class_id"/>
                            <field name="parent_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="birth_date"/>
                            <field name="gender"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- action moved to views/actions.xml -->
</odoo>
