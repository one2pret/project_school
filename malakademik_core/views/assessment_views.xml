<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_malakademik_assessment_list" model="ir.ui.view">
        <field name="name">malakademik.assessment.list</field>
        <field name="model">malakademik.assessment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="classroom_id"/>
            </list>
        </field>
    </record>

    <record id="view_malakademik_assessment_form" model="ir.ui.view">
        <field name="name">malakademik.assessment.form</field>
        <field name="model">malakademik.assessment</field>
        <field name="arch" type="xml">
            <form string="Assessment">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="subject_id"/>
                            <field name="teacher_id"/>
                            <field name="classroom_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="student_id"/>
                                    <field name="score"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- action moved to views/actions.xml -->
</odoo>
