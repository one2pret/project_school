<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_malakademik_student_export_wizard_form" model="ir.ui.view">
        <field name="name">malakademik.student.export.wizard.form</field>
        <field name="model">malakademik.student.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Students (Dapodik CSV)">
                <group>
                    <field name="class_id"/>
                    <field name="include_header"/>
                    <field name="delimiter"/>
                    <field name="file_name" readonly="1"/>
                    <field name="file_data" filename="file_name" readonly="1" widget="binary"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Generate" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_malakademik_student_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Students (CSV)</field>
        <field name="res_model">malakademik.student.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
